# Copy to .env and fill in locally. .env is git-ignored; never commit real values.
# Running on your own machine needs none of these.

# Where videos, outputs and the local SQLite database live.
# PADEL_DATA_DIR=./data

# Postgres instead of SQLite (e.g. a Supabase database). Keep the password here only.
# PADEL_DATABASE_URL=postgresql+psycopg://postgres:replace-me@db.your-project.supabase.co:5432/postgres

# Require this token on every API request (recommended once the API is reachable from the internet).
# PADEL_API_TOKEN=replace-me-with-a-long-random-string

# Web app origins allowed to call the API (JSON list).
# PADEL_CORS_ORIGINS=["http://localhost:3000"]
